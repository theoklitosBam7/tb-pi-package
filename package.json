{
  "name": "tb-pi-package",
  "version": "0.4.0",
  "description": "Extensions, subagents, and workflow prompts for the pi AI coding agent",
  "keywords": [
    "agents",
    "ai",
    "cli",
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/theoklitosBam7/tb-pi-package#readme",
  "bugs": {
    "url": "https://github.com/theoklitosBam7/tb-pi-package/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Theoklitos Bampouris",
    "email": "th.bampouris@gmail.com",
    "url": "https://github.com/theoklitosBam7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theoklitosBam7/tb-pi-package.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "typecheck": "tsc -p tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@types/node": "^24.12.3",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.63.0",
    "simple-git-hooks": "^2.13.1",
    "typebox": "^1.1.38",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run nano-staged"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.13",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
