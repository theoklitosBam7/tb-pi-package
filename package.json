{
  "name": "tb-pi-package",
  "version": "0.10.2",
  "description": "Extensions, subagents, and workflow prompts for the pi AI coding agent",
  "keywords": [
    "agents",
    "ai",
    "cli",
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/theoklitosBam7/tb-pi-package#readme",
  "bugs": {
    "url": "https://github.com/theoklitosBam7/tb-pi-package/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Theoklitos Bampouris",
    "email": "th.bampouris@gmail.com",
    "url": "https://github.com/theoklitosBam7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theoklitosBam7/tb-pi-package.git"
  },
  "type": "module",
  "scripts": {
    "hooks:setup": "simple-git-hooks",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint"
  },
  "dependencies": {
    "foundry-local-sdk": "2.0.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.19.1",
    "@types/turndown": "^5.0.6",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "simple-git-hooks": "^2.14.0",
    "typebox": "^1.3.36",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm lint"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@12.6.0",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
